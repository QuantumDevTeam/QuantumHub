<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(QhWindows)</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>$(MSBuildThisFileDirectory)../src/QuantumHub.Gui/Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/QuantumHub.Client/QuantumHub.Client.csproj" />
  </ItemGroup>
</Project>
