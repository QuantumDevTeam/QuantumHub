<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(QhDotnet)</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Contracts for QuantumHub plugins: IHubPlugin, the message bus and the UI builder.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../contracts/proto/**/*.proto" ProtoRoot="../../contracts/proto" GrpcServices="None" />
  </ItemGroup>
</Project>
