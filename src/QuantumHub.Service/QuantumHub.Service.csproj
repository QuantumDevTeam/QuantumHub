<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(QhWindows)</TargetFramework>
    <!-- Plugins load with whatever runtime the host has, so keep the host on the latest patch. -->
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>

  <!-- В релизе .NET лежит рядом с программой, в папке dotnet, поэтому на компьютере ничего ставить не надо. -->
  <PropertyGroup Condition="'$(QhPrivateRuntime)' == 'true'">
    <AppHostDotNetSearch>AppRelative;Global</AppHostDotNetSearch>
    <AppHostRelativeDotNet>dotnet</AppHostRelativeDotNet>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../QuantumHub.Core/QuantumHub.Core.csproj" />
  </ItemGroup>
</Project>
