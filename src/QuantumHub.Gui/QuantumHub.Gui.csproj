<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(QhWinUi)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>QuantumHub.Gui</AssemblyName>
  </PropertyGroup>

  <!-- В релизе .NET лежит рядом с программой, в папке dotnet, поэтому на компьютере ничего ставить не надо. -->
  <PropertyGroup Condition="'$(QhPrivateRuntime)' == 'true'">
    <AppHostDotNetSearch>AppRelative;Global</AppHostDotNetSearch>
    <AppHostRelativeDotNet>..\dotnet</AppHostRelativeDotNet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="../QuantumHub.Client/QuantumHub.Client.csproj" />
    <ProjectReference Include="../QuantumHub.Ui.Contracts/QuantumHub.Ui.Contracts.csproj" />
    <!-- Только порядок сборки: GUI запускает хаб отдельным процессом и не ссылается на его сборку. -->
    <ProjectReference Include="../QuantumHub.Service/QuantumHub.Service.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
