<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.1</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>QuantumDevTeam</Authors>
    <Company>QuantumDevTeam</Company>
    <Product>QuantumHub</Product>
    <Copyright>Copyright (c) 2026 QuantumDevTeam</Copyright>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <QhDotnet>net10.0</QhDotnet>
    <QhWindows>net10.0-windows</QhWindows>
    <QhWinUi>net10.0-windows10.0.26100.0</QhWinUi>
  </PropertyGroup>
</Project>
