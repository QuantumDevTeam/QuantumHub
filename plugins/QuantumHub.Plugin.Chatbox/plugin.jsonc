// Собирает строки из других плагинов и показывает их в чатбоксе VRChat.
{
  "id": "qh.vrchat.chatbox",
  "name": "VRChat Chatbox",
  "version": "1.1.0",
  "description": "Показывает в чатбоксе VRChat статус, активное окно, загрузку компьютера, время и музыку. Пока запущена игра, открыто окошко для статуса и сообщений.",
  "author": "QuantumDevTeam",
  "service": { "assembly": "QuantumHub.Plugin.Chatbox.dll" },
  "provides": [ { "name": "vrchat.chatbox", "version": "1.0.0" } ],
  "dependencies": [
    { "capability": "vrchat.osc", "version": ">=1.0.0" },
    { "capability": "user.activity", "version": ">=1.0.0" },
    { "capability": "media.player", "version": ">=1.0.0", "optional": true, "when": "lazy" },
    { "capability": "system.stats", "version": ">=1.0.0", "optional": true, "when": "lazy" }
  ],
  "settings": [
    {
      "key": "sending",
      "type": "bool",
      "group": "Отправка",
      "title": "Отправлять в VRChat",
      "description": "Только пока игра запущена.",
      "default": true
    },
    {
      "key": "intervalSeconds",
      "type": "number",
      "group": "Отправка",
      "title": "Обновлять раз в, секунд",
      "description": "Чаще VRChat всё равно не покажет.",
      "default": 3,
      "min": 2,
      "max": 30
    },
    {
      "key": "chatHoldSeconds",
      "type": "number",
      "group": "Отправка",
      "title": "Держать сообщение, секунд",
      "description": "Сколько отправленное сообщение остаётся вместо обычных строк.",
      "default": 8,
      "min": 2,
      "max": 60
    },
    {
      "key": "openPanel",
      "type": "bool",
      "group": "Отправка",
      "title": "Открывать мини-окно вместе с игрой",
      "default": true
    },
    { "key": "modStatus", "type": "bool", "group": "Что показывать", "title": "Личный статус", "default": true },
    {
      "key": "modWindow",
      "type": "bool",
      "group": "Что показывать",
      "title": "Активность окна",
      "description": "В VR показывает, что ты в VR, иначе приложение в фокусе.",
      "default": true
    },
    { "key": "modComponent", "type": "bool", "group": "Что показывать", "title": "Загрузка компьютера", "default": false },
    { "key": "modTime", "type": "bool", "group": "Что показывать", "title": "Текущее время", "default": true },
    { "key": "modMedia", "type": "bool", "group": "Что показывать", "title": "Музыка", "default": true },
    {
      "key": "showAway",
      "type": "bool",
      "group": "Оформление",
      "title": "Показывать Away, когда отошёл",
      "description": "Заменяет личный статус, пока нет ввода с клавиатуры и мыши. В VR не срабатывает.",
      "default": true
    },
    {
      "key": "awaySeconds",
      "type": "number",
      "group": "Оформление",
      "title": "Считать отошедшим через, секунд",
      "default": 300,
      "min": 30,
      "max": 1800
    },
    {
      "key": "awayText",
      "type": "string",
      "group": "Оформление",
      "title": "Текст вместо статуса",
      "default": "Away"
    },
    {
      "key": "windowSource",
      "type": "choice",
      "group": "Оформление",
      "title": "Что писать про окно",
      "description": "Заголовок окна увидят все в игре, а в нём бывают названия файлов и переписок.",
      "options": [ "process", "title", "both" ],
      "optionLabels": { "process": "Имя процесса", "title": "Заголовок окна", "both": "Процесс и заголовок" },
      "default": "process"
    },
    {
      "key": "template",
      "type": "list",
      "group": "Шаблон",
      "title": "Свой шаблон",
      "description": "Если заполнен, заменяет выбор строк выше. Подстановки: {status} {away} {window} {process} {title} {vr} {time} {stats} {cpu} {gpu} {ram} {vram} {song} {track} {artist} {progress} {position} {duration}. Строка, где все подстановки пусты, не показывается.",
      "default": []
    },
    {
      "key": "vrText",
      "type": "string",
      "group": "Оформление",
      "title": "Текст в VR",
      "default": "In VR"
    },
    {
      "key": "timeFormat",
      "type": "string",
      "group": "Оформление",
      "title": "Формат времени",
      "description": "Например HH:mm или hh:mm tt.",
      "default": "HH:mm"
    },
    {
      "key": "showProgress",
      "type": "bool",
      "group": "Оформление",
      "title": "Полоса прогресса трека",
      "default": true
    },
    { "key": "showCpu", "type": "bool", "group": "Загрузка компьютера", "title": "Процессор", "default": true },
    { "key": "showGpu", "type": "bool", "group": "Загрузка компьютера", "title": "Видеокарта", "default": true },
    { "key": "showRam", "type": "bool", "group": "Загрузка компьютера", "title": "Оперативная память", "default": true },
    { "key": "showVram", "type": "bool", "group": "Загрузка компьютера", "title": "Видеопамять", "default": true }
  ],
  "locales": {
    "en": {
      "description": "Shows your status, active window, computer load, time and music in the VRChat chatbox. While the game runs, a small window is open for status and messages.",
      "groups": {
        "Отправка": "Sending",
        "Что показывать": "What to show",
        "Оформление": "Style",
        "Шаблон": "Template",
        "Загрузка компьютера": "Computer load"
      },
      "settings": {
        "sending": {
          "title": "Send to VRChat",
          "description": "Only while the game is running."
        },
        "intervalSeconds": {
          "title": "Update every, seconds",
          "description": "VRChat will not show it more often anyway."
        },
        "chatHoldSeconds": {
          "title": "Hold a message for, seconds",
          "description": "How long a sent message stays instead of the usual lines."
        },
        "openPanel": {
          "title": "Open the mini window with the game"
        },
        "modStatus": {
          "title": "Personal status"
        },
        "modWindow": {
          "title": "Window activity",
          "description": "Shows that you are in VR, otherwise the focused app."
        },
        "modComponent": {
          "title": "Computer load"
        },
        "modTime": {
          "title": "Current time"
        },
        "modMedia": {
          "title": "Music"
        },
        "showAway": { "title": "Show Away when you step away", "description": "Replaces the personal status while there is no keyboard or mouse input. Does not trigger in VR." },
        "awaySeconds": { "title": "Count as away after, seconds" },
        "awayText": { "title": "Text instead of the status" },
        "windowSource": {
          "title": "What to show about the window",
          "description": "Everyone in the game sees the window title, and titles can contain file names and chats.",
          "options": {
            "process": "Process name",
            "title": "Window title",
            "both": "Process and title"
          }
        },
        "template": {
          "title": "Custom template",
          "description": "When filled, replaces the line selection above. Placeholders: {status} {away} {window} {process} {title} {vr} {time} {stats} {cpu} {gpu} {ram} {vram} {song} {track} {artist} {progress} {position} {duration}. A line whose placeholders are all empty is not shown."
        },
        "vrText": {
          "title": "Text in VR"
        },
        "timeFormat": {
          "title": "Time format",
          "description": "For example HH:mm or hh:mm tt."
        },
        "showProgress": {
          "title": "Track progress bar"
        },
        "showCpu": {
          "title": "Processor"
        },
        "showGpu": {
          "title": "Graphics card"
        },
        "showRam": {
          "title": "Memory"
        },
        "showVram": {
          "title": "Video memory"
        }
      }
    }
  }
}
