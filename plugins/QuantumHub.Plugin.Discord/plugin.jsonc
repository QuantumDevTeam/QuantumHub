// Клиент Discord без окон: подключается к запущенному приложению по локальному пайпу и отдаёт его другим плагинам.
{
  "id": "qh.discord",
  "name": "Discord",
  "version": "1.0.0",
  "description": "Подключается к запущенному Discord: мьют, текущий канал, участники, пинг, Rich Presence. Им пользуются другие плагины.",
  "author": "QuantumDevTeam",
  "service": { "assembly": "QuantumHub.Plugin.Discord.dll" },
  "provides": [ { "name": "discord.client", "version": "1.0.0" } ],
  "settings": [
    {
      "key": "clientId",
      "type": "string",
      "group": "Приложение Discord",
      "title": "Client ID",
      "description": "Из своего приложения на discord.com/developers. Пока пусто, плагин к Discord не подключается.",
      "default": ""
    },
    {
      "key": "clientSecret",
      "type": "secret",
      "group": "Приложение Discord",
      "title": "Client Secret",
      "description": "Нужен только для голоса и канала. Rich Presence работает и без него.",
      "default": ""
    },
    {
      "key": "redirectUri",
      "type": "string",
      "group": "Приложение Discord",
      "title": "Redirect URI",
      "description": "Такой же адрес должен быть указан в настройках OAuth2 приложения.",
      "default": "http://127.0.0.1"
    },
    {
      "key": "scopes",
      "type": "list",
      "group": "Приложение Discord",
      "title": "Разрешения",
      "description": "По одному на строку. Изменения вступят в силу при следующей авторизации.",
      "default": [ "rpc", "rpc.voice.read", "rpc.voice.write", "identify" ]
    },
    {
      "key": "autoConnect",
      "type": "bool",
      "group": "Подключение",
      "title": "Подключаться автоматически",
      "description": "Пока Discord не запущен, плагин просто ждёт его.",
      "default": true
    }
  ],
  "locales": {
    "en": {
      "description": "Connects to the running Discord: mute, current channel, members, ping, Rich Presence. Other plugins use it.",
      "groups": {
        "Приложение Discord": "Discord application",
        "Подключение": "Connection"
      },
      "settings": {
        "clientId": {
          "title": "Client ID",
          "description": "From your application on discord.com/developers. While empty, the plugin does not connect to Discord."
        },
        "clientSecret": {
          "title": "Client Secret",
          "description": "Only needed for voice and channel. Rich Presence works without it."
        },
        "redirectUri": {
          "title": "Redirect URI",
          "description": "The same address must be set in the OAuth2 settings of the application."
        },
        "scopes": {
          "title": "Scopes",
          "description": "One per line. Changes apply at the next authorization."
        },
        "autoConnect": {
          "title": "Connect automatically",
          "description": "While Discord is not running, the plugin just waits for it."
        }
      }
    }
  }
}
