// Всплывающие окошки для всех плагинов. Сами окна показывает внешняя часть, companion/QuantumHub.Notifier.exe.
{
  "id": "qh.ui.notify",
  "name": "Notifications",
  "version": "1.0.0",
  "description": "Небольшие всплывающие окошки поверх экрана. Ими может пользоваться любой плагин.",
  "author": "QuantumDevTeam",
  "service": { "assembly": "QuantumHub.Plugin.Notifications.dll" },
  "provides": [ { "name": "ui.notifications", "version": "1.0.0" } ],
  "settings": [
    {
      "key": "durationSeconds",
      "group": "Показ",
      "type": "number",
      "title": "Показывать, секунд",
      "default": 3,
      "min": 1,
      "max": 15
    },
    {
      "key": "opacity",
      "group": "Показ",
      "type": "number",
      "title": "Непрозрачность, %",
      "default": 85,
      "min": 30,
      "max": 100
    },
    {
      "key": "marginRight",
      "group": "Положение",
      "type": "number",
      "title": "Отступ справа",
      "default": 20,
      "min": 0,
      "max": 400
    },
    {
      "key": "marginTop",
      "group": "Положение",
      "type": "number",
      "title": "Отступ сверху",
      "default": 20,
      "min": 0,
      "max": 400
    }
  ]
}
