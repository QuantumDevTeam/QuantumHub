// Звуковые устройства Windows как сервис для других плагинов и внешних программ. Про VR ничего не знает.
{
  "id": "qh.audio",
  "name": "Audio Devices",
  "version": "1.0.0",
  "description": "Показывает, какие наушники и микрофон сейчас используются, и даёт плагинам и внешним программам их менять.",
  "author": "QuantumDevTeam",
  "service": { "assembly": "QuantumHub.Plugin.AudioDevices.dll" },
  "provides": [ { "name": "audio.devices", "version": "1.0.0" } ],
  "settings": [
    {
      "key": "checkSeconds",
      "type": "number",
      "title": "Проверять смену устройства раз в, секунд",
      "default": 2,
      "min": 1,
      "max": 30
    }
  ]
}
